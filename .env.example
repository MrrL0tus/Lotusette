# Configuration de Lotusette
# Copier ce fichier vers .env :  cp .env.example .env
#
# Toutes les valeurs ci-dessous sont les valeurs par défaut de
# lotusette/core/config.py. Un .env vide fonctionne : ne décommentez que ce
# que vous voulez changer.

# =============================================================================
# Application
# =============================================================================
APP_NAME=Lotusette
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# Fournisseur LLM
# =============================================================================
# local  : serveur local compatible OpenAI (llama.cpp, Ollama, vLLM) — défaut
# openai : API OpenAI, nécessite une clé
# claude : API Anthropic, nécessite une clé
LLM_PROVIDER=local

# --- Modèle local (aucune clé d'API requise) ---------------------------------
# Démarrer le serveur d'inférence en face, par exemple :
#   llama-server -hf mistralai/Ministral-3-14B-Instruct-2512-GGUF:Q4_K_M \
#     -c 16384 --port 8080 --host 127.0.0.1
# Voir docs/MODELS.md pour le choix du modèle selon la machine.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=mistralai/Ministral-3-14B-Instruct-2512-GGUF:Q4_K_M
# llama.cpp et Ollama ignorent cet en-tête, l'API OpenAI l'exige.
LOCAL_LLM_API_KEY=EMPTY

# Les anciens noms VLLM_BASE_URL / VLLM_MODEL / VLLM_API_KEY restent acceptés.

# --- API distantes ------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4-turbo-preview
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-opus-20240229

# --- Génération ---------------------------------------------------------------
# 0.6-0.8 pour la conversation, 0.1 pour les outils et la sortie JSON.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_CONTEXT_MESSAGES=20

# =============================================================================
# Base de données
# =============================================================================
# Par défaut : SQLite dans data/conversations/lotusette.db, aucun serveur à
# installer. PostgreSQL n'est utile qu'en déploiement multi-utilisateurs.
# DATABASE_URL=sqlite:///data/conversations/lotusette.db

# =============================================================================
# Sécurité
# =============================================================================
# Obligatoire dès que DEBUG=false en production.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY=

# =============================================================================
# Phases ultérieures (non implémentées, voir ROADMAP.md)
# =============================================================================
# Voix (E6)
# STT_PROVIDER=whisper
# TTS_PROVIDER=piper
# WHISPER_MODEL=base
#
# Recherche web (E5)
# SEARCH_PROVIDER=duckduckgo
#
# Gaming (Phase 5) / Robotique (Phase 6)
# ENABLE_GAMING=false
# ENABLE_ROBOTICS=false

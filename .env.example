# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Lotusette
DEBUG=false
LOG_LEVEL=INFO

# LLM Configuration
LLM_PROVIDER=openai  # openai, claude, local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lotusette
VECTOR_DB_TYPE=chroma  # chroma, pinecone, faiss
VECTOR_DB_URL=http://localhost:8000

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Voice Services
STT_PROVIDER=whisper  # whisper, google, vosk
TTS_PROVIDER=coqui  # coqui, elevenlabs, google
WHISPER_MODEL=base  # tiny, base, small, medium, large
ELEVENLABS_API_KEY=

# Web Services
SEARCH_PROVIDER=duckduckgo  # google, bing, duckduckgo
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Gaming
ENABLE_GAMING=false

# Robotics (Future)
ENABLE_ROBOTICS=false
ROS_MASTER_URI=http://localhost:11311

# Security
SECRET_KEY=your-secret-key-here-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Storage
STORAGE_TYPE=local  # local, s3
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring
ENABLE_METRICS=false
PROMETHEUS_PORT=9090

# Configuration supplémentaire pour les modèles locaux
# Ajoutez ces variables à votre fichier .env principal

# =============================================================================
# Configuration des Modèles Locaux
# =============================================================================

# Provider vLLM (serveur local avec API OpenAI)
# Décommenter pour utiliser vLLM:
# LLM_PROVIDER=local-vllm
# VLLM_BASE_URL=http://localhost:8001/v1
# VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Provider Transformers (chargement direct)
# Décommenter pour utiliser Transformers:
# LLM_PROVIDER=local-transformers
# LOCAL_MODEL=microsoft/phi-2
# USE_8BIT_QUANTIZATION=false
# USE_4BIT_QUANTIZATION=false
# DEVICE=auto

# Chemins pour les modèles locaux
MODELS_CACHE_DIR=./data/models
TRANSFORMERS_CACHE=./data/models/transformers
HF_HOME=./data/models/huggingface

# Configuration HuggingFace
# Optionnel: token pour télécharger des modèles privés
# HF_TOKEN=your-huggingface-token

# Performances
# Nombre de threads pour CPU (si pas de GPU)
# OMP_NUM_THREADS=4
# MKL_NUM_THREADS=4
